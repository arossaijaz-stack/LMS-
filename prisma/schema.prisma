// ============================================================
// LMS — Phase 0 Draft Schema
// This is a FOUNDATION draft. Each phase will extend/refine
// its relevant models when that phase is built.
// tenant_id fields are included now so the system can go
// multi-academy/multi-tenant later without a schema rewrite.
// ============================================================

// Supabase-specific setup (Phase 10): Supabase's connection pooler
// (PgBouncer, port 6543) is required for serverless/edge deployments
// like Netlify Functions, since each function invocation can open a new
// connection and Postgres has a hard connection limit — PgBouncer
// pools these efficiently. Prisma migrations, however, need a DIRECT
// connection (port 5432) because PgBouncer's transaction pooling mode
// doesn't support the prepared statements Prisma's migration engine
// uses. Hence two separate env vars:
//   DATABASE_URL — pooled (port 6543, ?pgbouncer=true) — used at runtime
//   DIRECT_URL   — direct (port 5432) — used only by `prisma migrate`
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------- TENANT (future-proofing) -------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  createdAt DateTime @default(now())

  brandSettings BrandSettings?
  users         User[]
  programs      Program[]
  contentBlocks ContentBlock[]
}

// ------------------- PHASE 1: AUTH & USERS -------------------

enum UserRole {
  STUDENT
  TEACHER
  CAMPUS_MANAGER
  ADMIN
  SUPPORT
  FINANCE
}

model User {
  id          String     @id @default(uuid())
  tenantId    String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  fullName    String
  email       String     @unique
  phone       String?
  passwordHash String
  role        UserRole   @default(STUDENT)
  avatarUrl   String?
  campusId    String?
  campus      Campus?    @relation(fields: [campusId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  submissions      AssignmentSubmission[]
  notesBookmarks   NoteBookmark[]
  lessonProgress   LessonProgress[]
  payments         Payment[]
  notifications    Notification[]
  taughtCourses    Course[]              @relation("TeacherCourses")
  liveClassBatches BatchStudent[]
  reviewedTransferRequests TransferRequest[] @relation("TransferReviewedBy")
  supportTickets   SupportTicket[] @relation("TicketOwner")
  assignedTickets  SupportTicket[] @relation("AssignedTickets")
  ticketMessages   TicketMessage[] @relation("TicketMessageAuthor")
}

model Campus {
  id      String @id @default(uuid())
  name    String
  address String?
  users   User[]
}

// ------------------- PHASE 2: PROGRAMS & COURSES -------------------

model Program {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String   // e.g. "Admission Tests Prep", "Coaching Classes"
  slug        String   @unique
  description String?
  iconUrl     String?
  courses     Course[]
}

enum PricingType {
  MONTHLY
  LUMP_SUM
}

model Course {
  id           String       @id @default(uuid())
  programId    String
  program      Program      @relation(fields: [programId], references: [id])
  title        String
  description  String?
  thumbnailUrl String?
  durationText String?      // e.g. "2.5 Months"
  pricingType  PricingType
  price        Decimal
  teacherId    String?
  teacher      User?        @relation("TeacherCourses", fields: [teacherId], references: [id])
  isFreeTrial  Boolean      @default(false)
  isPublished  Boolean      @default(false)
  createdAt    DateTime     @default(now())

  subjects     Subject[]
  enrollments  Enrollment[]
  batches      Batch[]
  incomingTransferRequests TransferRequest[] @relation("TransferRequestedCourse")
  payments     Payment[]
}

model Subject {
  id       String    @id @default(uuid())
  courseId String
  course   Course    @relation(fields: [courseId], references: [id])
  title    String
  order    Int       @default(0)
  chapters Chapter[]
}

model Chapter {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  title     String
  order     Int      @default(0)
  lessons   Lesson[]
}

enum LessonType {
  VIDEO
  READING
  QUIZ
  ASSIGNMENT
}

model Lesson {
  id         String     @id @default(uuid())
  chapterId  String
  chapter    Chapter    @relation(fields: [chapterId], references: [id])
  title      String
  type       LessonType
  order      Int        @default(0)

  videoUrl     String?   // Bunny/Cloudflare Stream URL
  readingBody  String?   // rich text / markdown
  quizId       String?   @unique
  quiz         Quiz?     @relation(fields: [quizId], references: [id])
  assignmentId String?   @unique
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  notesBookmarks NoteBookmark[]
  progressRecords LessonProgress[]
}

// ------------------- PHASE 3: ENROLLMENT -------------------

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  PENDING
  TRANSFERRED
}

model Enrollment {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(PENDING)
  startedAt DateTime         @default(now())
  expiresAt DateTime?

  transferRequests TransferRequest[]
  payments         Payment[]

  @@unique([userId, courseId])
}

// A student's request to move from their current course/enrollment
// into a different course. Requires Campus Manager or Admin approval
// (mirrors the "campus manager approval" workflow referenced in the
// KIPS Virtual FAQ).
enum TransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TransferRequest {
  id                String                @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment            @relation(fields: [enrollmentId], references: [id])
  requestedCourseId String
  requestedCourse   Course                @relation("TransferRequestedCourse", fields: [requestedCourseId], references: [id])
  reason            String?
  status            TransferRequestStatus @default(PENDING)
  reviewedById      String?
  reviewedBy        User?                 @relation("TransferReviewedBy", fields: [reviewedById], references: [id])
  createdAt         DateTime              @default(now())
  reviewedAt        DateTime?
}

// ------------------- PHASE 4: QUIZZES & ASSIGNMENTS -------------------

model Quiz {
  id          String    @id @default(uuid())
  title       String
  timeLimitMin Int?
  randomize   Boolean   @default(false)
  questions   Question[]
  attempts    QuizAttempt[]
  lesson      Lesson?
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  OPEN_ENDED
}

model Question {
  id           String       @id @default(uuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id])
  text         String
  type         QuestionType
  options      Json?        // [{id, text, isCorrect}]
  correctAnswer String?     // for open-ended, reference answer
  order        Int          @default(0)
}

model QuizAttempt {
  id         String   @id @default(uuid())
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  answers    Json
  score      Decimal?
  startedAt  DateTime @default(now())
  submittedAt DateTime?
}

model Assignment {
  id          String    @id @default(uuid())
  title       String
  instructions String?
  dueDate     DateTime?
  lesson      Lesson?
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fileUrl      String
  grade        Decimal?
  feedback     String?
  submittedAt  DateTime  @default(now())
}

// ------------------- PHASE 5: LIVE CLASSES -------------------

model Batch {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime?

  students      BatchStudent[]
  liveSessions  LiveSession[]
}

model BatchStudent {
  id      String @id @default(uuid())
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([batchId, userId])
}

model LiveSession {
  id           String   @id @default(uuid())
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id])
  title        String
  scheduledAt  DateTime
  zoomJoinUrl  String?
  recordingUrl String?
  attendance   Json?    // { userId: boolean }
}

// ------------------- PHASE 6: ENGAGEMENT -------------------

model NoteBookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  type      String   // "note" | "bookmark"
  content   String?
  createdAt DateTime @default(now())
}

// Tracks whether a student has marked a lesson (video/reading/quiz/
// assignment) as complete — the basis for course progress %, and
// distinct from QuizAttempt/AssignmentSubmission which track
// *performance*, not just *completion*.
model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ------------------- PHASE 7: PAYMENTS -------------------

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?      // e.g. 20 = 20% off — use EITHER this OR discountAmount, not both
  discountAmount  Decimal?  // fixed amount off, in course currency
  maxUses         Int?      // null = unlimited
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  payments Payment[]
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id])
  enrollmentId   String?
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id])
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  amount         Decimal
  currency       String        @default("PKR")
  gateway        String        // "jazzcash" | "easypaisa" | "stripe" | "cash"
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  createdAt      DateTime      @default(now())
}

// ------------------- PHASE 9: THEMING / BRAND SETTINGS -------------------

model BrandSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  academyName    String
  logoUrl        String?
  primaryColor   String   @default("#1E40AF")
  secondaryColor String   @default("#F59E0B")
  fontFamily     String   @default("Inter")
  heroTitle      String?
  heroSubtitle   String?
  heroImageUrl   String?
  updatedAt      DateTime @updatedAt
}

// ------------------- PHASE 9: CMS-LITE CONTENT BLOCKS -------------------
//
// Powers the marketing-site sections a client should be able to edit
// without a developer: feature highlights, testimonials, FAQs, etc.
// `section` is a free-form key ("features" | "testimonials" | "faq" | ...)
// so new section types don't require a schema change. `metadata` carries
// any section-specific extra fields (e.g. a testimonial's author name,
// an FAQ's category) without needing a table per content type.
model ContentBlock {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  section   String
  order     Int      @default(0)
  title     String?
  body      String?
  imageUrl  String?
  metadata  Json?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ------------------- PHASE 8: SUPPORT / TICKETING -------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("TicketOwner", fields: [userId], references: [id])
  subject      String
  status       TicketStatus  @default(OPEN)
  assignedToId String?
  assignedTo   User?         @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages     TicketMessage[]
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User          @relation("TicketMessageAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}
